{
  "permissions": {
    "allow": [
      "mcp__b1500__station_status",
      "mcp__b1500__list_recipes",
      "mcp__b1500__validate_plan",
      "mcp__b1500__run_plan",
      "mcp__b1500__list_runs",
      "mcp__b1500__get_run",
      "mcp__b1500__analyze_run",
      "mcp__b1500__annotate_run",
      "mcp__b1500__safe_shutdown",
      "Bash(uv run b1500 manual *)",
      "Bash(uv run b1500 bringup status*)",
      "Bash(uv run b1500 bringup propose-station*)",
      "Bash(uv run b1500 bringup capture*)",
      "Bash(uv run b1500 bringup record*)"
    ],
    "ask": [
      "mcp__b1500__run_confirmed_plan"
    ],
    "deny": [
      "Bash(b1500 fault *)",
      "Bash(uv run b1500 fault *)",
      "Bash(b1500 run --confirm *)",
      "Bash(uv run b1500 run --confirm *)",
      "Bash(b1500 config init*)",
      "Bash(uv run b1500 config init*)",
      "Bash(b1500 config adopt*)",
      "Bash(uv run b1500 config adopt*)",
      "Edit(config/local/**)",
      "Edit(data/**)",
      "Edit(.claude/settings*.json)",
      "Edit(.codex/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/scripts/hooks/b1500_guard.py"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
